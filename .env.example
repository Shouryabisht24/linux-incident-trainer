POSTGRES_DB=devops_trainer
POSTGRES_USER=trainer
POSTGRES_PASSWORD=changeme
JWT_SECRET=changeme-generate-a-real-secret
PORT=4000

# Optional — password-reset emails. If SMTP_HOST is unset, the backend logs the reset link instead
# of sending it (safe default for local/self-hosted use); set these to enable real delivery.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Linux Incident Trainer <no-reply@example.com>

# Optional — base URL used to build the link inside password-reset emails. Defaults to
# http://localhost:5173 (the dev frontend) if unset; override for a non-default port/domain.
# FRONTEND_URL=http://localhost:5173
